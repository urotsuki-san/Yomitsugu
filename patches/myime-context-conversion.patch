@@ -66,6 +66,52 @@ package final class Zenz {
         // 不一致範囲を除去するため、Converter単位のnative context再生成は不要。
     }
 
+    func rankedCandidates(_ candidates: [Candidate], input: String,
+                          mode: ConvertRequestOptions.ZenzaiVersionDependentMode) -> [Candidate] {
+        self.inferenceLock.withLock {
+            guard let context = self.zenzContext else { return candidates }
+            let prompt = ZenzPromptBuilder.candidateEvaluationPrompt(
+                input: input.toKatakana(), userDictionaryPrompt: "", versionDependentConfig: mode)
+            let prefix = context.encode(prompt, addBOS: true, addEOS: false)
+            guard !prefix.isEmpty else { return candidates }
+            let vocabulary = context.vocabSize
+            var scored: [(Int, Float)] = []
+            let encoded = candidates.enumerated().map {
+                ($0.offset, context.encode($0.element.text, addBOS: false, addEOS: true))
+            }.sorted { $0.1.lexicographicallyPrecedes($1.1) }
+            var previous = Array(prefix.prefix(0))
+            var prefixScores: [Float] = []
+            for (index, suffix) in encoded {
+                let shared = zip(previous, suffix).prefix { $0 == $1 }.count
+                var score: Float = shared == 0 ? 0 : prefixScores[shared - 1]
+                prefixScores = Array(prefixScores.prefix(shared))
+                if shared == suffix.count {
+                    scored.append((index, score))
+                    previous = suffix
+                    continue
+                }
+                let tokens = prefix + suffix
+                guard tokens.count < 500, !suffix.isEmpty,
+                      let logits = context.evaluationLogits(tokens: Array(tokens.dropLast()), startOffset: prefix.count + shared - 1)
+                else { return candidates }
+                for position in shared..<suffix.count {
+                    let token = suffix[position]
+                    let offset = (position - shared) * vocabulary
+                    var maximum = -Float.infinity
+                    for v in 0..<vocabulary { maximum = max(maximum, logits[offset + v]) }
+                    var sum: Float = 0
+                    for v in 0..<vocabulary { sum += expf(logits[offset + v] - maximum) }
+                    score += logits[offset + Int(token)] - maximum - logf(sum)
+                    prefixScores.append(score)
+                }
+                guard score.isFinite else { return candidates }
+                scored.append((index, score))
+                previous = suffix
+            }
+            return scored.sorted { $0.1 == $1.1 ? $0.0 < $1.0 : $0.1 > $1.1 }.map { candidates[$0.0] }
+        }
+    }
